{
  "name": "korero-chat-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare:media": "bash scripts/prepare-media.sh",
    "electron:dev": "bun run electron:build:service && node scripts/electron-dev.mjs",
    "electron:build:service": "bun run prepare:media --if-needed && cargo build --locked --manifest-path native/Cargo.toml --features desktop --bin desktop-client",
    "electron:start": "electron .",
    "electron:pack": "bun run build && bun run prepare:media --if-needed && cargo build --locked --release --manifest-path native/Cargo.toml --features desktop --bin desktop-client && electron-builder --linux --publish never",
    "mobile:sync": "bun run build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.3",
    "@capacitor/core": "8.6.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.3",
    "@capacitor/share": "8.0.3",
    "@elysia/eden": "1.4.10",
    "@friendofsvelte/tipex": "^0.3.1",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "^1.80.0",
    "@noble/curves": "2.4.0",
    "@tiptap/extensions": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "bits-ui": "2.22.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dompurify": "^3.5.0",
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "1.8.0",
    "mediasoup-client": "3.26.0",
    "svelte": "5.59.1",
    "tailwind-merge": "^3.7.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.3",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "1.4.5",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "svelte-check": "4.7.8",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "7.3.8"
  },
  "main": "electron/main.mjs",
  "productName": "Korero.chat",
  "description": "Korero.chat voice and chat client",
  "homepage": "https://github.com/WardPearce/korero",
  "author": {
    "name": "WardPearce",
    "email": "wardpearce@pm.me"
  }
}
