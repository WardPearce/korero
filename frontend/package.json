{
  "name": "korero-chat-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:start": "electron .",
    "electron:pack": "bun run build && electron-builder --linux --x64 --publish never",
    "mobile:sync": "bun run build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.3",
    "@capacitor/core": "8.6.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.3",
    "@capacitor/share": "8.0.3",
    "@friendofsvelte/tipex": "^0.3.1",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "^1.80.0",
    "@noble/hashes": "2.4.0",
    "@svelte-put/qr": "2.1.4",
    "@tiptap/core": "3.35.0",
    "@tiptap/extensions": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "bits-ui": "2.22.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.7",
    "dompurify": "^3.5.0",
    "electron-updater": "6.8.11",
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "1.8.0",
    "jsqr": "1.4.0",
    "korero-chat": "file:../sdk",
    "mediasoup-client": "3.26.0",
    "svelte": "5.59.1",
    "tailwind-merge": "^3.7.1",
    "tone": "^15.1.22",
    "ws": "8.23.0",
    "x11": "4.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.3",
    "@svelte-put/swipeable": "^1.2.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "1.4.5",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "smol-toml": "1.9.1",
    "svelte-check": "4.7.8",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "7.3.8"
  },
  "main": "electron/main.mjs",
  "desktopName": "korero-chat-frontend.desktop",
  "productName": "Korero.chat",
  "description": "Korero.chat voice and chat client",
  "homepage": "https://github.com/WardPearce/korero",
  "author": {
    "name": "WardPearce",
    "email": "wardpearce@pm.me"
  }
}
